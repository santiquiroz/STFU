{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "STFU",
  "version": "1.6.0",
  "identifier": "com.stfu.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "STFU",
        "width": 440,
        "height": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../../backend/dist/stfu-backend": "backend/stfu-backend"
    },
    "windows": {
      "nsis": {
        "compression": "zlib",
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
